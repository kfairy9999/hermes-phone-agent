# Copy to ~/.hermes/.env (or set HERMES_HOME and use that directory).
# Leave values empty in git. Never commit real keys.
#
# Groq is the default OpenAI-compatible model provider.
# Hermes reads GROQ_API_KEY because config/hermes.config.yaml sets key_env.
# Docs: https://hermes-agent.nousresearch.com/docs/integrations/providers
GROQ_API_KEY=

# --- Official telephony skill (telephony.py) ---
# https://hermes-agent.nousresearch.com/docs/user-guide/skills/optional/productivity/productivity-telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PHONE_NUMBER_SID=
BLAND_API_KEY=
# Skill default voice. save-bland writes this. mason is the script default.
BLAND_DEFAULT_VOICE=mason
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Skill defaults from telephony.py at Hermes v0.23.0.
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=cjVigY5qzO86Huf0OWal
VAPI_MODEL=gpt-4o
# Upstream telephony.py accepts only bland or vapi, and defaults to bland
# when this is unset. This wrapper also accepts mock. mock is the dry run.
# Leave this as mock unless you have set ORCHESTRATOR to the same live value.
PHONE_PROVIDER=mock

# --- This wrapper (telephony.py does not read these) ---
# mock | bland | vapi. mock refuses to contact Bland or Vapi.
# Issue 66963 names this variable ORCHESTRATOR. PHONE_PROVIDER does not
# override an explicit ORCHESTRATOR=mock.
ORCHESTRATOR=mock
# Comma-separated E.164 numbers. Empty means the file (if any) is the only list.
# The default file is $HERMES_HOME/phone_allowlist.txt and it starts empty.
PHONE_ALLOWLIST=
PHONE_ALLOWLIST_FILE=
PHONE_MAX_CALLS_PER_DAY=3
PHONE_MAX_TEXTS_PER_DAY=10
PHONE_MAX_DOLLARS_PER_DAY=2.00
# Local to PHONE_TIMEZONE. Empty disables. Overnight windows are supported.
PHONE_QUIET_HOURS=21:00-08:00
PHONE_TIMEZONE=America/Los_Angeles
PHONE_LOG_PATH=
PHONE_MOCK_STATE_PATH=
