{"version": 2, "width": 100, "height": 40, "timestamp": 1794159124, "title": "hermes-phone-agent mock demo", "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}}
[0.0, "o", "$ python scripts/demo_mock.py\r\n"]
[0.46, "o", "hermes-phone-agent\r\n"]
[0.52, "o", "mock mode \u00b7 Twilio, Bland, and Vapi are not contacted \u00b7 vendor spend $0\r\n"]
[0.58, "o", "allowlist: +13105550100 (555-0100, a fictional number)\r\n"]
[0.64, "o", "caps: 3 calls / 10 texts / $2.00 estimated per day\r\n"]
[0.7, "o", "Quiet hours are 21:00-08:00 America/Los_Angeles.\r\n"]
[0.76, "o", "HERMES_HOME: /tmp/hermes-phone-demo\r\n"]
[0.82, "o", "\r\n"]
[0.88, "o", "You: Text me a reminder at 5pm\r\n"]
[0.94, "o", "Agent: +1 310 555 0100 is on the allowlist. The text would say \"Reminder: 5pm.\"\r\n"]
[1.0, "o", "You: yes\r\n"]
[1.06, "o", "\r\n"]
[1.12, "o", "\u2500\u2500 1. Confirmed text\r\n"]
[1.18, "o", "$ python -m hermes_phone twilio-send-sms +13105550100 'Reminder: 5pm.' --confirm\r\n"]
[1.24, "o", "{\r\n"]
[1.3, "o", "  \"success\": true,\r\n"]
[1.36, "o", "  \"provider\": \"mock\",\r\n"]
[1.42, "o", "  \"mock\": true,\r\n"]
[1.48, "o", "  \"message_sid\": \"SM_mock_1\",\r\n"]
[1.54, "o", "  \"status\": \"queued\",\r\n"]
[1.6, "o", "  \"from_phone_number\": \"+13105550000\",\r\n"]
[1.66, "o", "  \"to_phone_number_masked\": \"***-***-0100\",\r\n"]
[1.72, "o", "  \"media_count\": 0,\r\n"]
[1.78, "o", "  \"vendor_spend_usd\": \"0\",\r\n"]
[1.84, "o", "  \"message\": \"SMS queued with the mock provider. Twilio was not contacted.\",\r\n"]
[1.9, "o", "  \"guard\": {\r\n"]
[1.96, "o", "    \"confirmed\": true,\r\n"]
[2.02, "o", "    \"estimated_cost_usd\": \"0.0083\",\r\n"]
[2.08, "o", "    \"vendor_spend_usd\": \"0\",\r\n"]
[2.14, "o", "    \"log\": \"/tmp/hermes-phone-demo/phone_audit.jsonl\",\r\n"]
[2.2, "o", "    \"orchestrator\": \"mock\"\r\n"]
[2.26, "o", "  }\r\n"]
[2.32, "o", "}\r\n"]
[2.38, "o", "(exit 0)\r\n"]
[2.44, "o", "\r\n"]
[2.5, "o", "You: Call +1 212 555 0199 and ask if they are free\r\n"]
[2.56, "o", "Agent: That number is not on the allowlist. I will not add it, and I will not dial it.\r\n"]
[2.62, "o", "\r\n"]
[2.68, "o", "\u2500\u2500 2. Unlisted number, refused even with --confirm\r\n"]
[2.74, "o", "$ python -m hermes_phone ai-call +12125550199 'Ask if they are free this week.' --confirm\r\n"]
[2.8, "o", "{\r\n"]
[2.86, "o", "  \"success\": false,\r\n"]
[2.92, "o", "  \"refused\": true,\r\n"]
[2.98, "o", "  \"error\": \"***-***-0199 is not on the allowlist. The allowlist is empty by default. Add the number only if it is yours or the person has opted in.\",\r\n"]
[3.04, "o", "  \"action\": \"ai-call\",\r\n"]
[3.1, "o", "  \"to_phone_number_masked\": \"***-***-0199\"\r\n"]
[3.16, "o", "}\r\n"]
[3.22, "o", "(exit 2)\r\n"]
[3.28, "o", "\r\n"]
[3.34, "o", "You: Call me and read the 5pm reminder\r\n"]
[3.4, "o", "Agent: That is the allowlisted number, still in mock mode. Confirm the call?\r\n"]
[3.46, "o", "You: yes\r\n"]
[3.52, "o", "\r\n"]
[3.58, "o", "\u2500\u2500 3. Confirmed mock call\r\n"]
[3.64, "o", "$ python -m hermes_phone ai-call +13105550100 'Read the 5pm reminder.' --first-sentence 'Hi, this is your reminder line.' --max-duration 3 --confirm\r\n"]
